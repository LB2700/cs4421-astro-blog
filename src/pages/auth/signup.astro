---
import AuthLayout from '../../layouts/AuthLayout.astro';
import TextInput from '../../components/TextInput.astro';

import "../../styles/auth.scss";
import "../../styles/buttons.scss";

const statusCode = Astro.url.searchParams.get('status');
const statusMessage =
	statusCode === 'check-email'
		? 'Confirm email to login'
		: null;

const errorCode = Astro.url.searchParams.get('error');
const errorMessage =
	errorCode === 'invalid-input'
		? 'Invalid email address or password'
		: errorCode === 'signup-failed'
			? 'Unable to sign up with those details. Check them and try again.'
			: null;
---
<AuthLayout>
	<form method="POST" action="/api/register">
	<h2>Sign up</h2>
	
		{statusMessage && <p class="form-message" role="alert">{statusMessage}</p>}
		{errorMessage && <p class="form-message form-message--error" role="alert">{errorMessage}</p>}


		<TextInput
			id="username"
			name="username"
			label="Username:"
			placeholder="Choose a username"
			autocomplete="username"
			required
		/>
		<TextInput
			id="email"
			name="email"
			label="Email:"
			type="email"
			placeholder="Enter your email"
			autocomplete="email"
			required
		/>
		<TextInput
			id="password"
			name="password"
			label="Password:"
			type="password"
			placeholder="Create a password"
			autocomplete="new-password"
			required
		/>

		<button class:list={["action-button", "action-button--primary", "form-submit"]} type="submit">Register</button>
	</form>
	<div class="auth-footer">
		<p>
			Already have an account? <a href="/auth/login">Log in</a>
		</p>
	</div>
</AuthLayout>