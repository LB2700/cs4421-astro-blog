---
interface Props {
	href: string;
	variant?: 'primary' | 'secondary';
}

const { href, variant = 'primary' } = Astro.props;
---

<a class:list={['action-button', `action-button--${variant}`]} href={href}>
	<slot />
</a>

<style lang="scss">
	@use "../styles/_variables.scss" as *;

	.action-button {
		display: inline-flex;
		min-height: 2.5rem;
		align-items: center;
		justify-content: center;
		padding: 0.2rem 1rem;
		border: 1px solid $charcoal-blue;
		border-radius: 999px;
		font-size: 0.95rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 150ms ease, color 150ms ease, box-shadow 150ms ease;

		&:focus-visible {
			outline: 2px solid $verdigris;
			outline-offset: 3px;
		}
	}

	.action-button--primary {
		background: $charcoal-blue;
		color: $porcelain;

		&:hover {
			background: $jet-black;
		}
	}

	.action-button--secondary {
		background: transparent;
		color: $charcoal-blue;

		&:hover {
			background: $porcelain;
		}
	}
</style>
