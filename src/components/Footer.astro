---
import packageJson from '../../package.json';

const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Luke Bermingham. All rights reserved.</p>
	<p class="site-info">{packageJson.name} {packageJson.version}</p>
</footer>
<style lang="scss">

@use "../styles/_variables.scss" as *;

	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		border-top: 1px solid $banner-liner;
		color: rgb(var(--gray));
		text-align: center;
	}
	.site-info {
		margin-top: 0.5em;
		font-size: 0.875em;
	}
</style>
